<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing goes to cloud backup (allowBackup="false": meetings stay on the phone). Android 12+
     moves app data to a new phone even so; the Ling key never goes (it is sealed by this phone's
     Keystore anyway), records and settings may. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="ling-api-key" />
    </device-transfer>
</data-extraction-rules>
