<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The one accent for every control (cursor, switches, dialogs), on the light ground. -->
    <style name="Cicada" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:colorAccent">#E8552B</item>
        <item name="android:colorPrimary">#15171C</item>
        <item name="android:colorControlActivated">#E8552B</item>
        <item name="android:windowBackground">#F3F4F6</item>
        <item name="android:statusBarColor">#F3F4F6</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:navigationBarColor">#F3F4F6</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:alertDialogTheme">@style/Cicada.Dialog</item>
    </style>
    <!-- Dialogs: sentence-case buttons in the dark accent (the bright one is under 4.5:1 on white). -->
    <style name="Cicada.Dialog" parent="@android:style/Theme.Material.Light.Dialog.Alert">
        <item name="android:colorAccent">#E8552B</item>
        <item name="android:buttonBarButtonStyle">@style/Cicada.DialogButton</item>
    </style>
    <style name="Cicada.DialogButton" parent="@android:style/Widget.Material.Light.Button.Borderless.Colored">
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">#B33B14</item>
        <item name="android:textSize">15sp</item>
    </style>
    <style name="Cicada.Translucent" parent="@android:style/Theme.Translucent.NoTitleBar" />
</resources>
